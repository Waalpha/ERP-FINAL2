rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant POS Collections
    match /tenants/{tenantId} {
      match /pos_products/{productId} {
        allow read, write: if true;
      }
      match /pos_sales/{saleId} {
        allow read, create: if true;
        allow update, delete: if true;
      }
      match /pos_stock_movements/{movementId} {
        allow read, create: if true;
        allow update, delete: if false; // Movements are append-only audit trail
      }
      match /pos_shifts/{shiftId} {
        allow read, write: if true;
      }
      match /pos_stock_counts/{countId} {
        allow read, create: if true;
        allow update, delete: if true;
      }
      match /pos_audit_logs/{logId} {
        allow read, create: if true;
        allow update, delete: if false; // Audit logs are immutable
      }
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Global multi-tenant ERP fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}



